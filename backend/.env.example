# Supply these through the deployment host's private environment, not this file.
APP_ENV=production
SCHEMA_AUTO_CREATE=false
REQUIRE_TESSERACT=true
DATABASE_URL=
JWT_SECRET=
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=
GOOGLE_CLIENT_ID=
PASSPORT_STORAGE_DIR=/app/storage/passports
ACTIVITY_LOG_DIR=/app/storage/activity-logs
# Passport assistant (Google Gemini). Leave empty to turn the assistant off.
# The free tier lets Google use prompts to improve its products: demo/test data only, never real passports.
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.5-flash-lite
# Optional password-reset email configuration:
RESET_FRONTEND_URL=
SMTP_HOST=
SMTP_FROM=
